  <style>
    :root { --ink:#17354a; --teal:#087e83; --cream:#f5f4ec; }
    * { box-sizing:border-box; }
    body { margin:0; font-family:"DM Sans",sans-serif; color:var(--ink); }
    .app-shell { width:100%; min-height:100%; background:radial-gradient(circle at 8% 12%,#d9f3eb 0,transparent 34%),#f5f4ec; }
    .heading-font { font-family:"Fraunces",serif; }

    .desktop-frame {
      background:linear-gradient(135deg,#344c56,#142936 64%,#394c55);
      padding:12px 12px 0; border-radius:22px 22px 10px 10px;
      box-shadow:0 25px 55px #193b4b29, inset 0 1px 1px #ffffff55;
    }
    .desktop-screen {
      position:relative; isolation:isolate; width:100%; aspect-ratio:16/9;
      min-height:290px; overflow:hidden; border-radius:11px 11px 3px 3px;
      background:#385c70;
      box-shadow:inset 0 0 0 1px #ffffff40;
    }
    .desktop-wallpaper {
      position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
      filter:saturate(.83) contrast(1.04);
    }
    .desktop-screen::after {
      content:""; position:absolute; inset:0; z-index:1; pointer-events:none;
      background:linear-gradient(112deg,#071d2c52 0%,transparent 42%,#edfaff1c 75%,#09263430 100%);
      box-shadow:inset 0 0 32px #071d2c55;
    }
    .screen-icons {
      position:absolute; z-index:2; left:3.1%; top:7%;
      display:flex; flex-direction:column; gap:clamp(9px,1.8vw,22px);
    }
    .screen-icon {
      display:flex; flex-direction:column; align-items:center; gap:3px;
      width:clamp(43px,7vw,72px); color:white; font-weight:600;
      font-size:clamp(8px,1vw,11px); line-height:1.12; text-align:center;
      text-shadow:0 1px 4px #081e2d,0 1px 2px #081e2d;
    }
    .icon-art {
      display:grid; place-items:center; width:clamp(24px,3.7vw,36px);
      height:clamp(25px,3.8vw,37px); filter:drop-shadow(0 3px 3px #09253688);
    }
    .folder-art {
      position:relative; width:31px; height:23px; margin-top:5px;
      border-radius:3px 4px 4px 4px;
      background:linear-gradient(145deg,#fff2b4,#d3a74f);
      box-shadow:inset 0 1px #fff8d4,0 2px 3px #142b4477;
    }
    .folder-art::before {
      content:""; position:absolute; left:1px; top:-5px; width:13px; height:7px;
      background:#e8c673; border-radius:3px 3px 0 0;
    }
    .bin-art {
      position:relative; width:24px; height:27px; margin-top:5px;
      background:linear-gradient(90deg,#c9e8ee,#fff,#bdd9e3);
      border:1px solid #94b4c0; border-radius:2px 2px 5px 5px;
      transform:perspective(50px) rotateX(-5deg);
    }
    .bin-art::before {
      content:""; position:absolute; left:-3px; top:-5px; width:28px; height:5px;
      border-radius:3px; background:linear-gradient(#fff,#b9d5df);
      border:1px solid #9dbcc6;
    }
    .bin-art::after { content:"♻"; position:absolute; inset:3px 0 0; color:#438aa2; font-size:17px; text-shadow:none; }
    .notes-art {
      width:25px; height:29px; background:linear-gradient(130deg,#fffef5,#e4ebe5);
      border-radius:2px; box-shadow:2px 2px 0 #c5d8dd;
      color:#658fa0; font-size:17px; line-height:28px; text-shadow:none;
    }

    .sample-window {
      position:absolute; z-index:2; left:31%; top:16%; width:48%; height:61%;
      overflow:hidden; border:1px solid #ffffffb5; border-radius:9px;
      background:#fafcfbeF;
      box-shadow:0 18px 40px #08233278,0 1px 1px #ffffff inset;
      backdrop-filter:blur(7px);
    }
    .window-bar {
      height:clamp(28px,16%,39px); display:flex; align-items:center;
      justify-content:space-between; padding:0 10px;
      background:#f5f8f8; border-bottom:1px solid #d9e3e6;
      color:#344c59; font-size:clamp(9px,1.1vw,12px); font-weight:700;
    }
    .window-title { display:flex; align-items:center; gap:7px; white-space:nowrap; }
    .tiny-folder { width:13px; height:10px; background:#e7bb60; border-radius:2px; }
    .window-controls { letter-spacing:clamp(2px,.8vw,9px); white-space:nowrap; color:#617780; font-weight:500; }
    .window-toolbar {
      height:17%; min-height:24px; display:flex; align-items:center; gap:8px;
      padding:0 11px; background:#ffffff; border-bottom:1px solid #e4e9ea;
      color:#637e8a; font-size:clamp(9px,1vw,12px);
    }
    .address-bar {
      margin-left:3px; flex:1; overflow:hidden; white-space:nowrap;
      border:1px solid #e0e8ea; border-radius:4px; padding:3px 7px;
      background:#fafcfc; color:#506a75;
    }
    .window-body { display:flex; height:calc(83% - clamp(28px,16%,39px)); min-height:0; }
    .window-sidebar { width:30%; padding:10px 6px; border-right:1px solid #e7eeef; background:#f7faf9; }
    .side-line { height:6px; margin:0 0 11px 3px; border-radius:5px; background:#d6e5e7; }
    .side-line:nth-child(2) { width:70%; background:#9bd5db; }
    .side-line:nth-child(3) { width:84%; }
    .side-line:nth-child(4) { width:60%; }
    .file-grid { display:flex; gap:clamp(8px,2vw,22px); align-items:flex-start; padding:13px 10px; }
    .file-item { width:clamp(27px,4vw,44px); text-align:center; }
    .file-item .folder-art { transform:scale(.75); transform-origin:top left; margin:0 0 -2px 4px; }
    .file-item i { display:block; height:4px; margin:2px auto; width:70%; border-radius:3px; background:#c8d5d9; }

    .taskbar {
      position:absolute; z-index:3; bottom:0; left:0; right:0;
      height:11%; min-height:34px; display:flex; align-items:center;
      gap:clamp(5px,1vw,11px); padding:0 2.3%;
      background:#e7eff0db; border-top:1px solid #ffffffb0;
      box-shadow:0 -5px 18px #082d3b22;
      backdrop-filter:blur(18px);
    }
    .start-symbol {
      display:grid; grid-template-columns:repeat(2,7px); gap:2px;
      margin-right:clamp(3px,.7vw,9px); filter:drop-shadow(0 1px 1px #26576a50);
    }
    .start-symbol i { width:7px; height:7px; background:#167aa9; }
    .search-pill {
      width:clamp(24px,12vw,115px); height:21px; border-radius:12px;
      border:1px solid #ffffffba; background:#ffffffa5;
      display:flex; align-items:center; gap:5px; padding:0 7px;
      color:#536b75; font-size:10px;
    }
    .search-glass { width:9px; height:9px; border:1.5px solid #587680; border-radius:50%; position:relative; flex:none; }
    .search-glass::after { content:""; position:absolute; width:4px; height:1px; right:-3px; bottom:-2px; background:#587680; transform:rotate(45deg); }
    .bar-app { width:clamp(15px,2vw,21px); height:clamp(15px,2vw,21px); border-radius:5px; box-shadow:0 2px 3px #2b637b40; }
    .bar-app.folder { background:linear-gradient(#f9da7a,#d9a84d); }
    .bar-app.browser { border-radius:50%; background:conic-gradient(#2bb39d,#2577bf,#2bb39d); border:3px solid #ffffff83; }
    .bar-app.notes { background:linear-gradient(135deg,#fff,#9dd0d2); }
    .bar-spacer { flex:1; }
    .tray { white-space:nowrap; display:flex; align-items:center; gap:clamp(3px,.6vw,8px); color:#294c5d; font-size:clamp(8px,1vw,11px); font-weight:700; }
    .tray-clock { text-align:right; line-height:1.1; }

    .circle-guide {
      position:absolute; z-index:3; left:50%; top:44%; transform:translate(-50%,-50%);
      width:min(74%,430px); aspect-ratio:1; max-height:88%; border:2px dashed #ffffff7a;
      border-radius:50%; pointer-events:none; box-shadow:0 0 0 1px #17354a33;
    }
    .hotspot {
      position:absolute; z-index:5; width:clamp(27px,3.4vw,37px);
      height:clamp(27px,3.4vw,37px); display:grid; place-items:center;
      border:2px solid white; border-radius:50%; background:#ffd166;
      color:#17354a; box-shadow:0 2px 0 #b36c32,0 4px 12px #09354c99;
      transform:translate(-50%,-50%); transition:transform .18s,background .18s;
      cursor:pointer;
    }
    .hotspot:hover { transform:translate(-50%,-50%) scale(1.14); }
    .hotspot:focus-visible,.close-button:focus-visible { outline:4px solid #ffde82; outline-offset:4px; }
    .hotspot.explored { background:#bce8d1; box-shadow:0 2px 0 #438f72,0 4px 12px #09354c99; }
    .hotspot.active { background:#fff; outline:3px solid #17354a; outline-offset:2px; }
    .cross { position:relative; width:14px; height:14px; }
    .cross::before,.cross::after {
      content:""; position:absolute; top:50%; left:50%; border-radius:2px;
      background:currentColor; transform:translate(-50%,-50%);
    }
    .cross::before { width:14px; height:3px; }
    .cross::after { width:3px; height:14px; }
    .hotspot.explored .cross::before { width:7px; height:3px; transform:translate(-85%,35%) rotate(45deg); }
    .hotspot.explored .cross::after { width:14px; height:3px; transform:translate(-35%,0) rotate(-45deg); }
    /* The marker centers sit beside the artwork so the icon itself remains visible. */
    .spot-icons { left:17%; top:17%; }
    .spot-recycle { left:17%; top:38%; }
    .spot-windows { left:76%; top:26%; }
    .spot-desktop { left:88%; top:43%; }
    .spot-start { left:8%; top:94%; }
    .spot-taskbar { left:55%; top:94%; }
    .spot-notifications { left:85%; top:94%; }

    .computer-stand { width:18%; height:28px; margin:auto; background:linear-gradient(90deg,#adc6ca,#e3eded,#adc6ca); }
    .computer-foot { width:34%; height:8px; margin:auto; border-radius:12px 12px 3px 3px; background:#9eb9bd; }
    .info-card { min-height:172px; }
    .info-panel[hidden],.completion[hidden],.intro-panel[hidden] { display:none; }
    @media(max-width:640px) {
      .desktop-frame { padding:7px 7px 0; border-radius:13px 13px 5px 5px; }
      .desktop-screen { min-height:255px; aspect-ratio:4/3; }
      .desktop-wallpaper { object-position:center; }
      .circle-guide { width:77%; }
      .screen-icons { left:2%; top:8%; gap:16px; }
      .screen-icon { width:43px; font-size:8px; }
      .icon-art { transform:scale(.78); height:26px; }
      .sample-window { left:31%; top:17%; width:54%; height:57%; }
      .window-sidebar { width:23%; }
      .window-toolbar { gap:4px; }
      .search-pill { width:24px; padding:0 6px; }
      .search-label { display:none; }
      .spot-icons { left:21%; top:17%; }
      .spot-recycle { left:21%; top:40%; }
      .spot-windows { left:82%; top:27%; }
      .spot-desktop { left:89%; top:58%; }
      .spot-start { left:12%; top:93%; }
      .spot-taskbar { left:58%; top:93%; }
      .spot-notifications { left:86%; top:93%; }
      .computer-stand { height:18px; }
    }
    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { transition:none!important; animation:none!important; } }
  </style>
