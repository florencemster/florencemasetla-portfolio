      <div data-template-id="info-card" class="canva-card info-card rounded-2xl p-6 shadow-sm border border-[#d8e5e5]" style="background: rgb(255, 255, 255);">
       <div id="intro-panel" class="intro-panel">
        <div class="mb-3 text-3xl" aria-hidden="true">
         ✳
        </div>
        <h2 data-template-id="intro-title" class="canva-text heading-font font-bold mb-2" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Ready to explore?</h2>
        <p data-template-id="intro-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">Choose any gold cross on the computer screen. Each one reveals something new about using a desktop.</p>
       </div>
       <div id="feature-panels" aria-live="polite">
        <section id="panel-desktop" class="info-panel" hidden="">
         <h2 data-template-id="desktop-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">The desktop</h2>
         <p data-template-id="desktop-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">The desktop is the main screen you see after a computer starts. Think of it as your workspace: it holds shortcuts and gives you a place to open programs.</p>
        </section>
        <section id="panel-icons" class="info-panel" hidden="">
         <h2 data-template-id="icons-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Icons</h2>
         <p data-template-id="icons-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">Icons are small pictures that represent apps, files, or folders. Selecting an icon can open the item it represents.</p>
        </section>
        <section id="panel-windows" class="info-panel" hidden="">
         <h2 data-template-id="windows-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Windows</h2>
         <p data-template-id="windows-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">A window is a framed area where an app or folder appears. You can usually move, resize, minimize, or close a window.</p>
        </section>
        <section id="panel-recycle" class="info-panel" hidden="">
         <h2 data-template-id="recycle-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Recycle Bin</h2>
         <p data-template-id="recycle-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">The Recycle Bin holds files you have deleted. You may be able to restore a file from it before the bin is emptied.</p>
        </section>
        <section id="panel-taskbar" class="info-panel" hidden="">
         <h2 data-template-id="taskbar-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Taskbar</h2>
         <p data-template-id="taskbar-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">The taskbar is the strip along the bottom of the screen. It helps you find open apps and switch between them.</p>
        </section>
        <section id="panel-start" class="info-panel" hidden="">
         <h2 data-template-id="start-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Start menu</h2>
         <p data-template-id="start-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">The Start menu helps you find and launch apps, search for things, and reach computer settings. Open it using the Start button on the taskbar.</p>
        </section>
        <section id="panel-notifications" class="info-panel" hidden="">
         <h2 data-template-id="notifications-title" class="canva-text heading-font font-bold mb-3" style="color: rgb(23, 53, 74); font-weight: 700; font-style: normal; font-size: 24px;">Notification area</h2>
         <p data-template-id="notifications-copy" class="canva-text leading-relaxed" style="color: rgb(56, 89, 107); font-weight: 400; font-style: normal; font-size: 16px;">Near the end of the taskbar, the notification area shows useful status symbols, such as sound and network connection, alongside the clock.</p>
        </section>
       </div><button id="close-panel" data-template-id="close-button" type="button" class="canva-button close-button mt-5 px-4 py-2 rounded-lg font-bold hover:opacity-80" hidden="" style="background: rgb(214, 241, 231); color: rgb(7, 93, 102); font-weight: 700; font-style: normal; font-size: 16px;">Close explanation</button>
      </div>
      <div id="completion" data-template-id="completion-card" class="canva-banner completion rounded-2xl p-5 shadow-sm" role="status" hidden="" style="background: rgb(214, 241, 231);">
       <h2 data-template-id="completion-title" class="canva-text heading-font font-bold mb-2" style="color: rgb(7, 93, 102); font-weight: 700; font-style: normal; font-size: 24px;">Brilliant work! ✨</h2>
       <p data-template-id="completion-copy" class="canva-text" style="color: rgb(36, 90, 87); font-weight: 400; font-style: normal; font-size: 16px;">You explored all seven desktop features. You can tap any cross again to review what you learned.</p>
      </div>
     </aside>
    </main>
   </div>
  </div>
  <script>
    const hotspots = [...document.querySelectorAll('.hotspot')];
    const explored = new Set();
    const intro = document.getElementById('intro-panel');
    const panels = [...document.querySelectorAll('.info-panel')];
    const closeButton = document.getElementById('close-panel');
    let active = null;

    function showFeature(feature) {
      const next = active === feature ? null : feature;
      active = next;
      intro.hidden = next !== null;
      panels.forEach(panel => { panel.hidden = panel.id !== 'panel-' + next; });
      closeButton.hidden = next === null;
      hotspots.forEach(button => {
        const selected = button.dataset.feature === next;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-pressed', String(selected));
      });
    }

    hotspots.forEach(button => {
      button.addEventListener('click', () => {
        const feature = button.dataset.feature;
        if (!explored.has(feature)) {
          explored.add(feature);
          button.classList.add('explored');
          button.setAttribute('aria-label', button.getAttribute('aria-label').replace('not yet explored', 'explored'));
          document.getElementById('progress-count').textContent = explored.size + ' / ' + hotspots.length;
          document.getElementById('progress-bar').setAttribute('aria-valuenow', String(explored.size));
          document.getElementById('progress-fill').style.width = (explored.size / hotspots.length * 100) + '%';
          if (explored.size === hotspots.length) document.getElementById('completion').hidden = false;
        }
        showFeature(feature);
      });
    });

    closeButton.addEventListener('click', () => {
      const previous = hotspots.find(button => button.dataset.feature === active);
      showFeature(null);
      if (previous) previous.focus();
    });
  </script>
 
</body></html>
